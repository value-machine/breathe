{
  "name": "plate-harness",
  "private": true,
  "version": "0.44.0",
  "type": "module",
  "packageManager": "pnpm@9.15.4",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "preinstall": "node scripts/check-node-version.cjs",
    "dev": "vite",
    "build": "tsc --project tsconfig.app.json && vite build",
    "preview": "vite preview",
    "deploy": "pnpm build && wrangler deploy",
    "preview:worker": "pnpm build && wrangler dev",
    "lint": "eslint . --cache --cache-location .eslintcache",
    "lint:fix": "eslint . --fix --cache --cache-location .eslintcache",
    "format": "prettier --write \"src/**/*.{ts,tsx,css}\"",
    "format:check": "prettier --check \"src/**/*.{ts,tsx,css}\"",
    "type-check": "tsc --noEmit --project tsconfig.app.json",
    "test": "vitest",
    "test:run": "vitest run",
    "test:classify": "node --test scripts/change-classify.test.cjs scripts/check-node-version.test.cjs scripts/test-staged.test.cjs scripts/harness_scan.test.cjs scripts/validate-git-workflow.test.cjs scripts/validate-version-sync.test.cjs scripts/ensure-deps-installed.test.cjs scripts/deny-git-write-on-main.test.cjs scripts/project-structure-validator.test.cjs scripts/modularity-report.test.cjs scripts/validate-skills.test.cjs scripts/sync-agent-config.test.mjs",
    "test:plugin": "node plugins/cursor-migration/test/run-tests.mjs",
    "test:staged": "node scripts/test-staged.cjs --dry-run",
    "test:staged:live": "node scripts/test-staged.cjs",
    "test:ui": "vitest --ui",
    "test:coverage": "vitest --coverage",
    "clean": "gts clean",
    "compile": "tsc",
    "fix": "gts fix",
    "prepare": "husky",
    "arch:check": "depcruise --config .dependency-cruiser.cjs --ignore-known .dependency-cruiser-baseline.json src",
    "arch:check:ci": "depcruise --config .dependency-cruiser.cjs --ignore-known .dependency-cruiser-baseline.json --output-type err-long src",
    "modularity:report": "node scripts/modularity-report.cjs",
    "arch:graph": "depcruise --config .dependency-cruiser.cjs --output-type dot src | dot -T svg > architecture-graph.svg",
    "arch:graph:html": "depcruise --config .dependency-cruiser.cjs --output-type html src > architecture-report.html",
    "arch:validate": "pnpm lint && pnpm arch:check",
    "arch:baseline": "depcruise --config .dependency-cruiser.cjs --output-type baseline src > .dependency-cruiser-baseline.json",
    "validate:structure": "node scripts/project-structure-validator.js && node scripts/validate-git-workflow.cjs",
    "validate:structure:json": "node scripts/project-structure-validator.js --format=json",
    "validate:git-workflow": "node scripts/validate-git-workflow.cjs",
    "validate:version-sync": "node scripts/validate-version-sync.js",
    "validate:docs:links": "node scripts/validate-markdown-links.js",
    "validate:docs:refs": "node scripts/validate-cursor-doc-references.js",
    "validate:docs": "pnpm validate:docs:links && pnpm validate:docs:refs",
    "validate:skills": "node scripts/validate-skills.cjs",
    "sync:agent-config": "node scripts/sync-agent-config.mjs",
    "validate:structure:staged": "node scripts/validate-staged.js",
    "validate:feature-docs": "node scripts/validate-feature-docs.js",
    "validate:feature-docs:strict": "node scripts/validate-feature-docs.js --strict",
    "validate:feature-docs:json": "node scripts/validate-feature-docs.js --format=json",
    "validate:feature-docs:staged": "node scripts/validate-feature-docs-staged.js",
    "validate:feature-size": "node scripts/validate-feature-size.js",
    "validate:feature-size:json": "node scripts/validate-feature-size.js --format=json",
    "validate:feature-size:staged": "node scripts/validate-feature-size-staged.js",
    "validate:feature-size:baseline": "node scripts/generate-feature-baseline.js --write",
    "arch:check:staged": "node scripts/arch-check-staged.js",
    "tokens:build": "tz build -c scripts/terrazzo.config.js",
    "tokens:check": "tz check -c scripts/terrazzo.config.js"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@supabase/supabase-js": "^2.106.2",
    "@tailwindcss/vite": "4.3.3",
    "@tanstack/react-query": "^5.100.14",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "lucide-react": "1.59.0",
    "radix-ui": "1.8.1",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "react-router-dom": "^7.16.0",
    "tailwind-merge": "3.7.0",
    "tailwindcss": "4.3.3",
    "tw-animate-css": "1.4.0"
  },
  "devDependencies": {
    "@tanstack/eslint-plugin-query": "^5.100.14",
    "@tanstack/react-query-devtools": "^5.100.14",
    "@terrazzo/cli": "2.9.0",
    "@terrazzo/plugin-css": "2.9.0",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^25.9.1",
    "@types/react": "^19.2.15",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.2",
    "@vitest/coverage-v8": "^4.1.7",
    "@vitest/ui": "^4.1.7",
    "ajv": "8",
    "ajv-formats": "3",
    "dependency-cruiser": "^17.4.2",
    "eslint": "^10.4.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-sonarjs": "^4.0.3",
    "gts": "^7.0.0",
    "husky": "^9.1.7",
    "jsdom": "^29.1.1",
    "lint-staged": "^17.0.5",
    "minimatch": "^10.2.5",
    "prettier": "^3.8.3",
    "typescript": "^6.0.3",
    "vite": "^8.0.14",
    "vitest": "^4.1.7",
    "wrangler": "4.102.0"
  },
  "lint-staged": {
    "*.{ts,tsx}": [
      "eslint --fix"
    ],
    "projectStructure.config.cjs": [
      "pnpm validate:structure"
    ],
    "featureBudgets.config.cjs": [
      "pnpm validate:feature-size"
    ],
    ".dependency-cruiser.cjs": [
      "eslint --fix",
      "pnpm arch:check"
    ]
  }
}
