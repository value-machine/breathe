{
  "font": {
    "$type": "fontFamily",
    "$description": "Font stacks. CSS: --<name>.",
    "body-font": {
      "$value": ["Inter", "sans-serif"]
    },
    "heading-font": {
      "$value": ["Cinzel", "serif"],
      "$description": "Engraved Roman capitals for headings."
    },
    "mono-font": {
      "$value": [
        "ui-monospace",
        "SFMono-Regular",
        "Menlo",
        "Consolas",
        "Liberation Mono",
        "monospace"
      ]
    }
  },
  "shape": {
    "$type": "dimension",
    "$description": "Corner radii. card-radius / input-radius are optional overrides derived in src/index.css (@theme inline).",
    "radius": {
      "$value": {
        "value": 0.25,
        "unit": "rem"
      },
      "$description": "Base radius; Tailwind rounded-sm/md/lg/xl derive from it."
    },
    "button-radius": {
      "$value": "{shape.radius}",
      "$description": "Plate buttons: follow the base radius."
    }
  },
  "spacing": {
    "$type": "dimension",
    "spacing": {
      "$value": {
        "value": 0.25,
        "unit": "rem"
      },
      "$description": "Tailwind spacing unit (density)."
    }
  },
  "layout": {
    "$type": "dimension",
    "app-toolbar-height": {
      "$value": {
        "value": 64,
        "unit": "px"
      }
    }
  },
  "motion": {
    "$description": "Durations and easing. Reduced motion: reduced-motion.tokens.json.",
    "duration-fast": {
      "$type": "duration",
      "$value": {
        "value": 150,
        "unit": "ms"
      }
    },
    "duration-normal": {
      "$type": "duration",
      "$value": {
        "value": 200,
        "unit": "ms"
      }
    },
    "duration-slow": {
      "$type": "duration",
      "$value": {
        "value": 600,
        "unit": "ms"
      }
    },
    "ease-standard": {
      "$type": "cubicBezier",
      "$value": [0.4, 0, 0.2, 1]
    }
  },
  "elevation": {
    "$type": "shadow",
    "$description": "Shadows used by the elevation-* utilities. Brand elevations vary by mode (light/dark files).",
    "elevation-sm": {
      "$value": [
        {
          "color": {
            "colorSpace": "srgb",
            "components": [0, 0, 0],
            "alpha": 0.1,
            "hex": "#000000"
          },
          "offsetX": {
            "value": 0,
            "unit": "px"
          },
          "offsetY": {
            "value": 1,
            "unit": "px"
          },
          "blur": {
            "value": 3,
            "unit": "px"
          },
          "spread": {
            "value": 0,
            "unit": "px"
          }
        },
        {
          "color": {
            "colorSpace": "srgb",
            "components": [0, 0, 0],
            "alpha": 0.1,
            "hex": "#000000"
          },
          "offsetX": {
            "value": 0,
            "unit": "px"
          },
          "offsetY": {
            "value": 1,
            "unit": "px"
          },
          "blur": {
            "value": 2,
            "unit": "px"
          },
          "spread": {
            "value": -1,
            "unit": "px"
          }
        }
      ]
    },
    "elevation-md": {
      "$value": [
        {
          "color": {
            "colorSpace": "srgb",
            "components": [0, 0, 0],
